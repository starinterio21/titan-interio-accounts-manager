// Supabase Edge Function: extract-bill
// Receives a base64-encoded PDF/image of a supplier bill, sends it to
// Google's Gemini API (free tier) with a prompt asking for structured JSON,
// and returns the extracted fields. The file itself is never stored —
// it's only used in-memory for this one request.

const GEMINI_API_KEY = Deno.env.get('GEMINI_API_KEY')!

const corsHeaders = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Headers': 'authorization, x-client-info, apikey, content-type',
  'Access-Control-Allow-Methods': 'POST, OPTIONS',
}

function json(body, status = 200) {
  return new Response(JSON.stringify(body), {
    status,
    headers: { ...corsHeaders, 'Content-Type': 'application/json' },
  })
}

const EXTRACTION_PROMPT = `You are reading a supplier purchase bill (invoice) image or PDF for an aluminium fabrication business in India.

Extract these fields and respond with ONLY a JSON object, no other text, no markdown code fences:

{
  "supplier_name": "the supplier/vendor/seller company name, or null if not found",
  "bill_number": "the invoice/bill number, or null",
  "bill_date": "the bill date in YYYY-MM-DD format, or null if not found",
  "description": "a short one-line summary of what was purchased (e.g. 'Aluminium profiles and hardware'), or null",
  "taxable_amount": <number, the amount before tax, or 0 if not found>,
  "cgst": <number, CGST amount if shown, else 0>,
  "sgst": <number, SGST amount if shown, else 0>,
  "igst": <number, IGST amount if shown, else 0>,
  "total_amount": <number, the final total/grand total, or 0 if not found>
}

If the bill only shows a single combined GST amount rather than separate CGST/SGST, put the full amount in cgst and leave sgst as 0.
If you cannot read the document clearly, still return your best-effort JSON with nulls/zeros for anything unclear — never refuse.`

Deno.serve(async (req) => {
  if (req.method === 'OPTIONS') {
    return new Response('ok', { headers: corsHeaders })
  }

  try {
    const { base64Data, mimeType } = await req.json()

    if (!base64Data || !mimeType) {
      return json({ error: 'Missing file data' }, 400)
    }

    const geminiRes = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${GEMINI_API_KEY}`,
      {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [
            {
              parts: [
                { text: EXTRACTION_PROMPT },
                { inline_data: { mime_type: mimeType, data: base64Data } },
              ],
            },
          ],
          generationConfig: { temperature: 0.1 },
        }),
      }
    )

    if (!geminiRes.ok) {
      const errText = await geminiRes.text()
      return json({ error: 'Gemini API error', details: errText }, 500)
    }

    const geminiData = await geminiRes.json()
    const textResponse = geminiData?.candidates?.[0]?.content?.parts?.[0]?.text || ''

    // Strip markdown code fences if the model added them despite instructions
    const cleaned = textResponse.replace(/```json\s*|\s*```/g, '').trim()

    let extracted
    try {
      extracted = JSON.parse(cleaned)
    } catch (parseErr) {
      return json({ error: 'Could not parse extraction result', raw: textResponse }, 500)
    }

    return json({ success: true, data: extracted })
  } catch (err) {
    return json({ error: err.message }, 500)
  }
})

